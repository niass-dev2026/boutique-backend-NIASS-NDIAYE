    "paths": {
        "/acheteurs": {
            "get": {
                "tags": [
                    "Acheteurs"
                ],
                "summary": "Lister tous les acheteurs",
                "operationId": "3048d16a74d411acda3cbc100611d321",
                "responses": {
                    "200": {
                        "description": "Liste des acheteurs"
                    }
                }
            },
            "post": {
                "tags": [
                    "Acheteurs"
                ],
                "summary": "Créer un acheteur",
                "operationId": "f6a1f76165e42643d45d60f141ce6fa6",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nom",
                                    "email"
                                ],
                                "properties": {
                                    "nom": {
                                        "type": "string",
                                        "example": "Moussa Sarr"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "moussa.sarr@example.com"
                                    },
                                    "telephone": {
                                        "type": "string",
                                        "example": "781234567"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Acheteur créé"
                    },
                    "422": {
                        "description": "Erreur de validation"
                    }
                }
            }
        },
        "/acheteurs/{id}": {
            "get": {
                "tags": [
                    "Acheteurs"
                ],
                "summary": "Afficher le détail d'un acheteur",
                "operationId": "09860c055857cc04361e86f7c71d5d68",
