                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "nom": {
                                        "type": "string",
                                        "example": "Moussa Sarr"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "moussa.sarr@example.com"
                                    },
                                    "telephone": {
                                        "type": "string",
                                        "example": "781234567"
                                    }
                                },
                                "type": "object"
                            }
                        }
