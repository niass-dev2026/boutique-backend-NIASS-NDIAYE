                }
            },
            "delete": {
                "tags": [
                    "Acheteurs"
                ],
                "summary": "Supprimer un acheteur",
                "operationId": "9045802096d4fba8184cb073107e0eee",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
